  "components": [
    {
      "name": "Botón primario",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "La única acción índigo de la pantalla; nombra su objeto y, en formularios, lleva su atajo.",
      "html": "<button class=\"ds-btn-primary\">Crear tarea <kbd>Ctrl&nbsp;↵</kbd></button>",
      "css": ".ds-btn-primary{font-family:var(--font-sans,'Instrument Sans Variable',ui-sans-serif,system-ui,sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:6px;height:30px;padding:0 12px;border-radius:6px;font-size:13px;font-weight:500;white-space:nowrap;cursor:pointer;transition:background-color 120ms cubic-bezier(.2,.8,.2,1),color 120ms cubic-bezier(.2,.8,.2,1);border:0;box-shadow:inset 0 1px 0 rgb(255 255 255 / .16),0 1px 2px rgb(0 0 0 / .2);background:var(--nx-accent,#13857a);color:var(--nx-on-accent,#fff);}.ds-btn-primary:hover{background:var(--nx-accent-strong,#0a7a70);}.ds-btn-primary:focus-visible{outline:2px solid var(--nx-accent,#13857a);outline-offset:2px;}.ds-btn-primary kbd{font-family:'Geist Mono Variable',ui-monospace,monospace;font-size:11px;font-weight:500;margin-left:4px;padding:0 4px;border-radius:4px;background:rgba(0,0,0,.15);}"
    },
    {
      "name": "Botón secundario",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Acciones de apoyo: Hecha, Nueva vista, Volver a hoy, \"Nuevo\" del navbar.",
      "html": "<button class=\"ds-btn-secondary\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg> Hecha</button>",
      "css": ".ds-btn-secondary{font-family:var(--font-sans,'Instrument Sans Variable',ui-sans-serif,system-ui,sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:6px;height:30px;padding:0 12px;border-radius:6px;font-size:13px;font-weight:500;white-space:nowrap;cursor:pointer;transition:background-color 120ms cubic-bezier(.2,.8,.2,1),color 120ms cubic-bezier(.2,.8,.2,1);border:1px solid var(--nx-border,#e4e6ea);background:var(--nx-surface,#fff);color:var(--nx-text,#17181b);}.ds-btn-secondary:hover{background:var(--nx-surface-hover,#eef0f3);}.ds-btn-secondary:focus-visible{outline:2px solid var(--nx-accent,#13857a);outline-offset:2px;}"
    },
    {
      "name": "Botón fantasma",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Acciones terciarias sin borde: Cancelar, Pasar a mañana, Cerrar el día.",
      "html": "<button class=\"ds-btn-ghost\">Cancelar</button>",
      "css": ".ds-btn-ghost{font-family:var(--font-sans,'Instrument Sans Variable',ui-sans-serif,system-ui,sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:6px;height:30px;padding:0 12px;border-radius:6px;font-size:13px;font-weight:500;white-space:nowrap;cursor:pointer;transition:background-color 120ms cubic-bezier(.2,.8,.2,1),color 120ms cubic-bezier(.2,.8,.2,1);border:0;background:transparent;color:var(--nx-text-muted,#5b5f69);}.ds-btn-ghost:hover{background:var(--nx-surface-hover,#eef0f3);color:var(--nx-text,#17181b);}.ds-btn-ghost:focus-visible{outline:2px solid var(--nx-accent,#13857a);outline-offset:2px;}"
    },
    {
      "name": "Fichas de propiedad",
      "kind": "chip",
      "refersTo": "property-chip",
      "description": "Fila de propiedades del formulario de tarea; vacía muestra el nombre en tinta atenuada.",
      "html": "<div class=\"ds-chips\"><button class=\"ds-chip\"><span class=\"ds-prio\"><i style=\"height:5px\"></i><i style=\"height:8px\"></i><i style=\"height:11px\"></i></span>Alta</button><button class=\"ds-chip\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M8 2v4\"/><path d=\"M16 2v4\"/><rect width=\"18\" height=\"18\" x=\"3\" y=\"4\" rx=\"2\"/><path d=\"M3 10h18\"/></svg>Lun 28 · 10:00</button><button class=\"ds-chip empty\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><line x1=\"10\" x2=\"14\" y1=\"2\" y2=\"2\"/><line x1=\"12\" x2=\"15\" y1=\"14\" y2=\"11\"/><circle cx=\"12\" cy=\"14\" r=\"8\"/></svg>Estimación</button></div>",
      "css": ".ds-chips{display:flex;flex-wrap:wrap;gap:6px;}.ds-chip{font-family:var(--font-sans,'Instrument Sans Variable',ui-sans-serif,system-ui,sans-serif);display:inline-flex;align-items:center;gap:6px;height:28px;max-width:14rem;padding:0 10px;border:1px solid var(--nx-border,#e4e6ea);border-radius:6px;background:transparent;color:var(--nx-text,#17181b);font-size:13px;font-weight:500;cursor:pointer;transition:background-color 120ms;}.ds-chip.empty{color:var(--nx-text-muted,#5b5f69);}.ds-chip:hover,.ds-chip[aria-expanded=true]{background:var(--nx-surface-hover,#eef0f3);}.ds-chip:focus-visible{outline:2px solid var(--nx-accent,#13857a);outline-offset:2px;}.ds-prio{display:inline-flex;align-items:flex-end;gap:1px;height:12px;width:14px;flex:none;}.ds-prio i{width:3px;border-radius:1px;background:var(--nx-text-muted,#5b5f69);}"
    },
    {
      "name": "Campo de texto",
      "kind": "input",
      "refersTo": "input",
      "description": "Input con caja: papel, filete, 6px; foco con borde y contorno índigo.",
      "html": "<input class=\"ds-input\" placeholder=\"Nombre del proyecto\" />",
      "css": ".ds-input{font-family:var(--font-sans,'Instrument Sans Variable',ui-sans-serif,system-ui,sans-serif);width:260px;padding:5px 10px;border:1px solid var(--nx-border-strong,#d3d6dc);border-radius:6px;background:var(--nx-surface,#fff);color:var(--nx-text,#17181b);font-size:13px;line-height:20px;}.ds-input::placeholder{color:var(--nx-text-faint,#6b707a);}.ds-input:focus-visible{border-color:var(--nx-accent,#13857a);outline:2px solid var(--nx-accent,#13857a);outline-offset:2px;}"
    },
    {
      "name": "Navegación lateral",
      "kind": "nav",
      "refersTo": "nav-item",
      "description": "Secciones con icono Lucide y atajo \"g x\"; la activa en gris de selección con icono índigo.",
      "html": "<nav class=\"ds-nav\"><a class=\"on\" href=\"#\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect width=\"7\" height=\"7\" x=\"3\" y=\"3\" rx=\"1\"/><rect width=\"7\" height=\"7\" x=\"14\" y=\"3\" rx=\"1\"/><rect width=\"7\" height=\"7\" x=\"14\" y=\"14\" rx=\"1\"/><rect width=\"7\" height=\"7\" x=\"3\" y=\"14\" rx=\"1\"/></svg><span>Hoy</span><small>g h</small></a><a href=\"#\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"5\" width=\"6\" height=\"6\" rx=\"1\"/><path d=\"m3 17 2 2 4-4\"/><path d=\"M13 6h8\"/><path d=\"M13 12h8\"/><path d=\"M13 18h8\"/></svg><span>Tareas</span><small>g t</small></a></nav>",
      "css": ".ds-nav{font-family:var(--font-sans,'Instrument Sans Variable',ui-sans-serif,system-ui,sans-serif);width:224px;padding:12px;background:var(--nx-bg-soft,#f4f5f7);border-right:1px solid var(--nx-border,#e4e6ea);display:flex;flex-direction:column;gap:2px;}.ds-nav a{display:flex;align-items:center;gap:10px;height:32px;padding:0 10px;border-radius:6px;color:var(--nx-text-muted,#5b5f69);text-decoration:none;font-size:14px;font-weight:500;transition:background-color 120ms;}.ds-nav a:hover{background:var(--nx-surface-hover,#eef0f3);color:var(--nx-text,#17181b);}.ds-nav a.on{background:var(--nx-surface-hover,#eef0f3);color:var(--nx-text,#17181b);}.ds-nav a.on svg{color:var(--nx-accent,#13857a);}.ds-nav a:focus-visible{outline:2px solid var(--nx-accent,#13857a);outline-offset:2px;}.ds-nav small{margin-left:auto;font-size:12px;color:var(--nx-text-faint,#6b707a);font-variant-numeric:tabular-nums;}"
    },
    {
      "name": "Segmentado / Pestañas",
      "kind": "custom",
      "refersTo": "segmented-control",
      "description": "tablist con marco de 8px; el segmento activo en gris de selección; flechas para cambiar.",
      "html": "<div class=\"ds-seg\" role=\"tablist\"><button role=\"tab\" aria-selected=\"true\">Semana</button><button role=\"tab\" aria-selected=\"false\" tabindex=\"-1\">Mes</button><button role=\"tab\" aria-selected=\"false\" tabindex=\"-1\">Año</button></div>",
      "css": ".ds-seg{font-family:var(--font-sans,'Instrument Sans Variable',ui-sans-serif,system-ui,sans-serif);display:inline-flex;gap:2px;padding:2px;border-radius:8px;background:var(--nx-surface-hover,#eef0f3);}.ds-seg button{height:28px;padding:0 12px;border:0;border-radius:6px;background:transparent;color:var(--nx-text-muted,#5b5f69);font:inherit;font-size:13px;font-weight:500;cursor:pointer;}.ds-seg button:hover{color:var(--nx-text,#17181b);}.ds-seg button[aria-selected=true]{background:var(--nx-surface,#fff);box-shadow:inset 0 0 0 1px var(--nx-border,#e4e6ea);color:var(--nx-text,#17181b);}.ds-seg button:focus-visible{outline:2px solid var(--nx-accent,#13857a);outline-offset:2px;}"
    },
    {
      "name": "Fila de tarea",
      "kind": "custom",
      "refersTo": "list-row",
      "description": "Filas de 40px: estado por forma, prioridad en barras (solo P1 roja), atraso solo en la fecha naranja; fila activa con barra índigo.",
      "html": "<div class=\"ds-rows\"><div class=\"ds-row on\"><span class=\"ds-circ\"></span><span class=\"t\">Revisar la propuesta del cliente</span><span class=\"ds-prio\"><i style=\"height:5px;background:var(--nx-prio-1,#e5592e)\"></i><i style=\"height:8px;background:var(--nx-prio-1,#e5592e)\"></i><i style=\"height:11px;background:var(--nx-prio-1,#e5592e)\"></i></span><span class=\"m\">hoy</span></div><div class=\"ds-row\"><span class=\"ds-circ\"></span><span class=\"t\">Llamar al dentista</span><span class=\"ds-prio\"><i style=\"height:5px\"></i><i style=\"height:8px\"></i><i style=\"height:11px;background:var(--nx-border-strong,#c9ccd3)\"></i></span><span class=\"m late\">hace 12 días</span></div><div class=\"ds-row\"><span class=\"ds-circ done\"><svg width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg></span><span class=\"t done\">Meditar</span><span class=\"ds-prio\"><i style=\"height:5px\"></i><i style=\"height:8px;background:var(--nx-border-strong,#c9ccd3)\"></i><i style=\"height:11px;background:var(--nx-border-strong,#c9ccd3)\"></i></span><span class=\"m\">ayer</span></div></div>",
      "css": ".ds-rows{font-family:var(--font-sans,'Instrument Sans Variable',ui-sans-serif,system-ui,sans-serif);width:560px;border:1px solid var(--nx-border,#e4e6ea);border-radius:8px;overflow:hidden;background:var(--nx-surface,#fff);box-shadow:var(--nx-shadow-card,0 1px 2px rgba(20,20,30,.04));}.ds-row{display:flex;align-items:center;gap:10px;height:40px;padding:0 12px;border-bottom:1px solid var(--nx-border,#e4e6ea);font-size:14px;color:var(--nx-text,#17181b);}.ds-row:last-child{border-bottom:0;}.ds-row:hover{background:var(--nx-surface-hover,#eef0f3);}.ds-row.on{background:var(--nx-surface-hover,#eef0f3);box-shadow:inset 2px 0 0 var(--nx-accent,#13857a);}.ds-row .t{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}.ds-row .t.done{color:var(--nx-text-muted,#5b5f69);text-decoration:line-through;}.ds-row .m{width:92px;text-align:right;font-size:13px;color:var(--nx-text-muted,#5b5f69);font-variant-numeric:tabular-nums;}.ds-row .m.late{color:var(--nx-warning,#b86a0a);}.ds-circ{display:grid;place-items:center;width:16px;height:16px;flex:none;border-radius:50%;border:1.5px solid var(--nx-text-muted,#5b5f69);}.ds-circ.done{border-color:var(--nx-accent,#13857a);background:var(--nx-accent,#13857a);color:var(--nx-on-accent,#fff);}.ds-prio{display:inline-flex;align-items:flex-end;gap:1px;height:12px;width:14px;flex:none;}.ds-prio i{width:3px;border-radius:1px;background:var(--nx-text-muted,#5b5f69);}"
    },
    {
      "name": "Bloque Ahora",
      "kind": "custom",
      "refersTo": "now-block",
      "description": "Componente firma: la tarea que toca como ficha medida, con línea de medida, cuatro casillas y tres acciones.",
      "html": "<section class=\"ds-now\"><div class=\"h\"><span class=\"c\"></span><b>Ahora</b><span class=\"r\">quedan 13 min</span></div><h2>Revisar la propuesta del cliente</h2><div class=\"ds-meter\" role=\"meter\" aria-label=\"Tiempo de la tarea\" aria-valuenow=\"32\" aria-valuemin=\"0\" aria-valuemax=\"45\"><span class=\"f\" style=\"width:71%\"></span><span class=\"tl\"></span><span class=\"tr\"></span><span class=\"d\">45 min</span><span class=\"s\">10:30</span><span class=\"e\">11:15</span></div><dl class=\"ds-cells\"><div><dt>Proyecto</dt><dd><i></i>Lanzamiento web</dd></div><div><dt>Prioridad</dt><dd>Alta</dd></div><div><dt>Energía</dt><dd>Media</dd></div><div><dt>Objetivo</dt><dd>Publicar la nueva web</dd></div></dl><div class=\"a\"><button class=\"p\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><polygon points=\"6 3 20 12 6 21 6 3\"/></svg> Empezar foco</button><button class=\"s2\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg> Hecha</button><button class=\"g\">Pasar a mañana</button></div></section>",
      "css": ".ds-now{font-family:var(--font-sans,'Instrument Sans Variable',ui-sans-serif,system-ui,sans-serif);width:600px;padding:20px;border:1px solid var(--nx-border,#e4e6ea);border-radius:8px;background:var(--nx-surface,#fff);color:var(--nx-text,#17181b);}.ds-now .h{display:flex;align-items:center;gap:8px;font-size:14px;}.ds-now .h b{font-weight:600;color:var(--nx-text-muted,#5b5f69);}.ds-now .h .r{margin-left:auto;color:var(--nx-text-muted,#5b5f69);font-variant-numeric:tabular-nums;}.ds-now .c{width:14px;height:14px;border-radius:50%;border:1.5px solid var(--nx-accent,#13857a);background:conic-gradient(var(--nx-accent,#13857a) 0 50%,transparent 0);}.ds-now h2{margin:8px 0 0;font-size:20px;font-weight:600;letter-spacing:-.025em;line-height:1.4;}.ds-meter{position:relative;height:2px;margin:20px 0 32px;border-radius:9999px;background:var(--nx-border,#e4e6ea);}.ds-meter .f{position:absolute;top:0;bottom:0;left:0;border-radius:9999px;background:var(--nx-accent,#13857a);}.ds-meter .tl,.ds-meter .tr{position:absolute;top:-5px;width:1.5px;height:12px;border-radius:9999px;background:var(--nx-text-faint,#6b707a);}.ds-meter .tl{left:0;}.ds-meter .tr{right:0;}.ds-meter .d{position:absolute;left:50%;top:-10px;transform:translateX(-50%);padding:0 8px;background:var(--nx-surface,#fff);font-size:13px;font-weight:500;font-variant-numeric:tabular-nums;}.ds-meter .s,.ds-meter .e{position:absolute;top:10px;font-size:12px;color:var(--nx-text-muted,#5b5f69);font-variant-numeric:tabular-nums;}.ds-meter .s{left:0;}.ds-meter .e{right:0;}.ds-cells{display:grid;grid-template-columns:repeat(4,1fr);margin:0;border:1px solid var(--nx-border,#e4e6ea);border-radius:8px;overflow:hidden;}.ds-cells>div{min-width:0;padding:8px 12px;border-left:1px solid var(--nx-border,#e4e6ea);}.ds-cells>div:first-child{border-left:0;}.ds-cells dt{font-size:12px;color:var(--nx-text-muted,#5b5f69);}.ds-cells dd{margin:2px 0 0;display:flex;align-items:center;gap:6px;font-size:14px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}.ds-cells dd i{width:8px;height:8px;border-radius:50%;flex:none;background:#13857a;}.ds-now .a{display:flex;gap:8px;margin-top:16px;}.ds-now .a button{font-family:var(--font-sans,'Instrument Sans Variable',ui-sans-serif,system-ui,sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:8px;height:32px;padding:0 12px;border-radius:6px;font-size:14px;font-weight:500;white-space:nowrap;cursor:pointer;transition:background-color 120ms cubic-bezier(.25,1,.5,1),color 120ms cubic-bezier(.25,1,.5,1);border:0;}.ds-now .a .p{background:var(--nx-accent,#13857a);color:var(--nx-on-accent,#fff);}.ds-now .a .p:hover{background:var(--nx-accent-strong,#0a7a70);}.ds-now .a .s2{border:1px solid var(--nx-border,#e4e6ea);background:var(--nx-surface,#fff);color:var(--nx-text,#17181b);}.ds-now .a .s2:hover,.ds-now .a .g:hover{background:var(--nx-surface-hover,#eef0f3);color:var(--nx-text,#17181b);}.ds-now .a .g{background:transparent;color:var(--nx-text-muted,#5b5f69);}.ds-now .a button:focus-visible{outline:2px solid var(--nx-accent,#13857a);outline-offset:2px;}"
    },
    {
      "name": "Semana del hábito",
      "kind": "custom",
      "refersTo": "week-day",
      "description": "Siete círculos de solo lectura: hecho índigo con marca, pendiente con borde, descanso discontinuo, hoy con anillo de tinta.",
      "html": "<ol class=\"ds-week\" aria-label=\"Esta semana\"><li class=\"done\" aria-label=\"Lunes: hecho\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg></li><li class=\"done\" aria-label=\"Martes: hecho\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg></li><li class=\"miss\" aria-label=\"Miércoles: sin hacer\">X</li><li class=\"rest\" aria-label=\"Jueves: descanso\">J</li><li class=\"miss today\" aria-label=\"Viernes: pendiente hoy\">V</li><li class=\"miss\" aria-label=\"Sábado: por venir\">S</li><li class=\"rest\" aria-label=\"Domingo: descanso\">D</li></ol>",
      "css": ".ds-week{font-family:var(--font-sans,'Instrument Sans Variable',ui-sans-serif,system-ui,sans-serif);display:flex;gap:4px;margin:0;padding:8px;list-style:none;background:var(--nx-surface,#fff);}.ds-week li{display:grid;place-items:center;width:24px;height:24px;border-radius:50%;border:1px solid var(--nx-border-strong,#c9ccd3);font-size:12px;font-weight:500;color:var(--nx-text-muted,#5b5f69);}.ds-week li.done{border-color:var(--nx-accent,#13857a);background:var(--nx-accent,#13857a);color:var(--nx-on-accent,#fff);}.ds-week li.rest{border-style:dashed;color:var(--nx-text-faint,#6b707a);}.ds-week li.today{box-shadow:0 0 0 2px var(--nx-surface,#fff),0 0 0 4px var(--nx-text,#17181b);}"
    },
    {
      "name": "Tecla",
      "kind": "custom",
      "refersTo": "kbd",
      "description": "Atajo de teclado en menús, la barra lateral y la paleta.",
      "html": "<span class=\"ds-kbd-row\">Buscar <kbd class=\"ds-kbd\">Ctrl</kbd><kbd class=\"ds-kbd\">K</kbd></span>",
      "css": ".ds-kbd-row{font-family:var(--font-sans,'Instrument Sans Variable',ui-sans-serif,system-ui,sans-serif);display:inline-flex;align-items:center;gap:4px;font-size:13px;color:var(--nx-text,#17181b);}.ds-kbd{display:inline-block;min-width:18px;padding:0 6px;border-radius:4px;background:var(--nx-surface-hover,#eef0f3);color:var(--nx-text-muted,#5b5f69);font-family:'Geist Mono Variable',ui-monospace,monospace;font-size:11px;line-height:17px;font-weight:500;letter-spacing:-.01em;text-align:center;}"
    },
    {
      "name": "Celebración",
      "kind": "custom",
      "refersTo": "celebration",
      "description": "Destello de acento y barrido del borde inferior al completar (700 ms). Única microcelebración; solo visual.",
      "html": "<div class=\"ds-cel\"><span>Llamar al dentista</span><span class=\"ds-cel-flash\" aria-hidden=\"true\"></span><span class=\"ds-cel-sweep\" aria-hidden=\"true\"></span></div>",
      "css": ".ds-cel{font-family:var(--font-sans,'Instrument Sans Variable',ui-sans-serif,system-ui,sans-serif);position:relative;overflow:hidden;width:280px;height:36px;display:flex;align-items:center;padding:0 12px;border-radius:8px;box-shadow:inset 0 0 0 1px var(--nx-border,#e4e6ea);font-size:13px;color:var(--nx-text,#17181b);}.ds-cel-flash{position:absolute;inset:0;background:var(--nx-accent-soft,rgb(13 143 131 / .1));animation:ds-cel-f 700ms ease-out infinite 1.2s;opacity:0;pointer-events:none;}.ds-cel-sweep{position:absolute;left:0;bottom:0;height:1px;width:45%;background:linear-gradient(90deg,transparent,var(--nx-accent,#13857a),transparent);animation:ds-cel-s 750ms cubic-bezier(.3,0,.2,1) infinite 1.2s;opacity:0;pointer-events:none;}@keyframes ds-cel-f{0%{opacity:0}50%{opacity:1}100%{opacity:0}}@keyframes ds-cel-s{0%{transform:translateX(-100%);opacity:0}33%{opacity:1}66%{opacity:1}100%{transform:translateX(230%);opacity:0}}@media (prefers-reduced-motion:reduce){.ds-cel-sweep{display:none}.ds-cel-flash{animation-duration:140ms}}"
    }
  ],
  "narrative": {
    "northStar": "«Línea», precisión tranquila",
    "overview": "Nextuss es una herramienta de trabajo diario para alguien con TDAH: todo se hace a mano desde el teclado y no hay nada que sobre. La identidad v2 nace de la fase A del rediseño (issue #174; mockups en `docs/design/rediseno-v2/ronda-2/direcciones/linea/`). Se basa en tres ideas:\n- **Oscura primero:** el tema oscuro es el principal, con grises fríos. El claro tiene sus propios valores y se cuida igual.\n- **Filetes de 1 px:** separan tarjetas y filas. No hay sombras en la página.\n- **Un único acento:** turquesa glaciar, reservado para acción, selección y progreso.\n\nLa personalidad está en el movimiento, firme y preciso, con un solo destello al completar.\n\nEste documento sustituye a la v1 («La herramienta precisa», Inter e índigo), que se conserva en `docs/design-history/DESIGN-v1.md`. **Estado: fase 0** (issue #176). Aquí están cerrados los tokens: color, tipografía, radios, elevación y motion. Los componentes siguen como en la v1 hasta que la fase 1 los rehaga, así que la sección Components remite a ese documento.",
    "keyCharacteristics": [
      "**Temas:** el oscuro es casi negro azulado (`#0d0e10`) con un lateral aún más hundido. El claro es papel frío (`#fbfbfc`) con lateral gris al 4 %.",
      "**Color:** un solo acento turquesa. El ámbar dice «esto va tarde» y la brasa, «urgente».",
      "**Superficies:** se separan por filete de 1 px. Solo flota lo que flota (diálogos, menús y avisos).",
      "**Tipografía:** Instrument Sans para todo el texto y Geist Mono para cifras, horas, atajos y códigos.",
      "**Formas antes que color:** los estados y la prioridad se dicen por forma o por texto, nunca solo por color.",
      "**Movimiento:** cada animación responde a una acción o a un cambio real, y nada va en bucle. Con movimiento reducido, solo hay fundidos."
    ],
    "rules": [
      {
        "name": "La Regla de la Voz Única",
        "body": "El turquesa marca acción, selección y progreso, y nada más. Hay un solo botón primario por pantalla.",
        "section": "colors"
      },
      {
        "name": "La Regla sin Halo",
        "body": "No hay sombras de color ni brillos alrededor del acento. Las barras de progreso son lisas.",
        "section": "colors"
      },
      {
        "name": "La Regla de la Forma",
        "body": "Prioridad, estado y atraso se distinguen en escala de grises: por forma, por texto o por posición.",
        "section": "colors"
      },
      {
        "name": "La Regla de las Cifras en Mono",
        "body": "Horas, duraciones, contadores, atajos en `kbd` y códigos de prioridad usan `font-mono`. Las frases que contienen un número no la usan.",
        "section": "typography"
      },
      {
        "name": "La Regla del Suelo de 12 px",
        "body": "Se mantiene de la v1.",
        "section": "typography"
      },
      {
        "name": "La Regla de lo que Flota",
        "body": "Hay sombra si algo está por encima de la página (diálogo, menú, aviso, paleta) y en ningún otro caso.",
        "section": "elevation"
      },
      {
        "name": "La Regla sin Bucle",
        "body": "Nada se mueve solo, salvo el progreso real (el temporizador del foco o el tramo transcurrido del bloque Ahora).",
        "section": "motion"
      }
    ],
    "dos": [
      "Usar siempre los alias `--color-*` / `--nx-*`, nunca hex en componentes. La deuda actual está en el inventario del PR de la fase 0.",
      "Poner forma o texto junto a cualquier color con significado.",
      "Usar `font-mono` para cifras y atajos.",
      "Usar los tokens de motion y `motionFor`."
    ],
    "donts": [
      "Usar sombras de color o halos.",
      "Usar más de un botón primario por pantalla.",
      "Usar la escala `--nx-ref-*` directamente en componentes.",
      "Poner animaciones en bucle.",
      "Usar `light-dark()` en los tokens: `chartTheme.ts` los lee con `getPropertyValue` y necesita colores ya resueltos."
    ]
  }
