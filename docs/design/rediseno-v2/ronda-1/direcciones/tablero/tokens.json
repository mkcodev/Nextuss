  "pares": [
    ["text", "bg", "texto"],
    ["text", "surface", "texto"],
    ["text", "hover", "texto"],
    ["text", "accent-soft", "texto"],
    ["muted", "surface", "texto"],
    ["muted", "bg", "texto"],
    ["muted", "hover", "texto"],
    ["faint", "surface", "texto"],
