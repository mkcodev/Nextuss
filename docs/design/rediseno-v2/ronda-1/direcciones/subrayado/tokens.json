{
  "nombre": "Subrayado",
  "nivel": "intermedia",
  "frase": "Tus apuntes del día, marcados con fluorescente: lo que toca ahora salta a la vista y lo hecho queda marcado.",
  "firma": "El fluorescente con cuatro trabajos: amarillo = ahora y selección, verde = hecho y progreso, rosa = urgente, y el trazo de la microcelebración.",
  "tipografia": {
    "unica": {
      "familia": "Recursive Variable",
      "paquete": "@fontsource-variable/recursive",
      "css": "casl.css",
      "ejes": {
        "wght": "300-1000",
        "CASL": "0-1"
      },
      "uso": "CASL 0 en la interfaz, 0,5 en secciones y 0,85 en títulos"
    },
    "licencia": "OFL-1.1"
  },
  "color": {
    "light": {
      "bg": "#fafaf7",
      "bg-side": "#f2f2ec",
      "surface": "#ffffff",
      "hover": "#efefe7",
      "border": "#e4e4da",
      "border-strong": "#8c8c80",
      "text": "#23262b",
      "muted": "#555a61",
      "faint": "#62676e",
      "accent": "#23262b",
      "accent-strong": "#3a3e45",
      "on-accent": "#ffffff",
      "hl-yellow": "#ffe45c",
      "hl-green": "#a6e8b0",
      "hl-pink": "#ffb3d1",
      "on-hl": "#23262b",
      "cursor-row": {
        "mix": [
          "hl-yellow",
          0.3,
          "surface"
        ]
      },
      "warning": "#9a4a0b",
      "success": "#2f7d45",
      "danger": "#b42a3c",
      "focus": "#23262b",
      "level-bg": {
        "mix": [
          "hl-green",
          0.55,
          "bg"
        ]
      }
    },
    "dark": {
      "bg": "#17181b",
      "bg-side": "#131416",
      "surface": "#1d1f23",
      "hover": "#272a2f",
      "border": "#2e3137",
