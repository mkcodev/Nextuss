  },
  "sombras": {
    "tarjeta": "0 1px 2px rgb(35 38 43 / 0.05)",
    "flotante": "0 20px 50px -20px rgb(35 38 43 / 0.3)",
    "flotante-oscuro": "0 20px 50px -20px rgb(0 0 0 / 0.7)"
  },
  "motion": {
    "dur-1": "160ms",
    "dur-2": "200ms",
    "dur-3": "250ms",
    "ease": "cubic-bezier(0.3, 0.7, 0.1, 1)",
    "celebracion": {
      "duracion": "480ms",
      "que": "un trazo de fluorescente verde cruza el título y queda tachado",
      "reducido": "solo opacidad"
    }
  },
  "densidad": {
    "fila": "44px",
    "separacion": "24px",
    "relleno-caja": "18px"
